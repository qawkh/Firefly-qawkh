---
interface Props {
	class: string;
	"data-qawkh-about-content"?: boolean | string;
}
const className = Astro.props.class;
const aboutContentAttr = Astro.props["data-qawkh-about-content"];
---
<div
    data-pagefind-body
    data-qawkh-about-content={aboutContentAttr !== undefined ? "" : undefined}
    class={`prose dark:prose-invert prose-base max-w-none! custom-md ${className}`}
>
    <slot/>
</div>
