---
import { getPostUrlBySlug, url } from "@utils/url-utils";
import PostCard from "@/components/layout/PostCard.astro";
import { siteConfig } from "@/config";
import type { PostForList } from "@/utils/content-utils";

const { page } = Astro.props;

let delay = 0;
const interval = 50;

const masonryEnabled = siteConfig.postListLayout.grid.masonry;
const columnWidth = siteConfig.postListLayout.grid.columnWidth || 280;

// 根据配置设置初始布局模式，避免闪烁
const defaultLayout = siteConfig.postListLayout.defaultMode || "list";
const mobileDefaultLayout =
	siteConfig.postListLayout.mobileDefaultMode || defaultLayout;
const initialLayoutClass =
	defaultLayout === "grid"
		? "post-grid-auto grid-mode"
		: "flex flex-col gap-4 md:gap-4 list-mode";
const articlesEndpoint =
	import.meta.env.PUBLIC_QAWKH_ARTICLES_ENDPOINT || "/api/user/articles";
const publicApiBase = import.meta.env.PUBLIC_QAWKH_API_BASE || "";
const runtimeArticlesUrl = /^https?:\/\//i.test(articlesEndpoint)
	? articlesEndpoint
	: publicApiBase
		? `${publicApiBase.replace(/\/$/, "")}/${articlesEndpoint.replace(/^\/+/, "")}`
		: articlesEndpoint;
const runtimePostDetailUrl = url("/posts/remote/");
const runtimePageSize = page.size || siteConfig.pagination.postsPerPage;
function getListSignaturePart(entry: PostForList) {
	return encodeURIComponent(
		JSON.stringify([
			entry.id,
			entry.data.title,
			entry.data.description || "",
			entry.data.image || "",
			entry.data.category || "",
			entry.data.tags || [],
			Boolean(entry.data.pinned),
			entry.data.published.getTime(),
		]),
	);
}
const renderedPostSignature = page.data
	.map((entry: PostForList) => getListSignaturePart(entry))
	.join("|");
---

<div
  id="post-list-container"
  class={`transition-all duration-500 ease-in-out mb-4 ${initialLayoutClass}`}
  data-default-layout={defaultLayout}
  data-mobile-default-layout={mobileDefaultLayout}
  data-masonry-enabled={masonryEnabled}
  data-column-width={columnWidth}
  data-rendered-post-signature={renderedPostSignature}
  style={`--post-card-min-width: ${columnWidth}px;`}
>
  {
    page.data.map((entry: PostForList, index: number) => (
      <PostCard
        entry={entry}
        title={entry.data.title}
        tags={entry.data.tags}
        category={entry.data.category}
        published={entry.data.published}
        updated={entry.data.updated}
        url={getPostUrlBySlug(entry.id)}
        image={entry.data.image}
        description={entry.data.description}
        draft={entry.data.draft}
        pinned={entry.data.pinned}
        password={!!entry.data.password}
        loading={index < 2 ? "eager" : "lazy"}
        class:list="onload-animation post-card-item"
        style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
      />
    ))
  }
</div>

<script is:inline define:vars={{ runtimeArticlesUrl, runtimePostDetailUrl, runtimePageSize }}>
  (function initRuntimeArticles() {
    if (window.__fireflyRuntimeArticlesBound) return;
    window.__fireflyRuntimeArticlesBound = true;

    function normalizeText(value) {
      return typeof value === "string" ? value.trim() : "";
    }

    function escapeHtml(value) {
      return normalizeText(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function toTimestamp(value) {
      const text = normalizeText(value);
      if (!text) return Date.now();
      const timestamp = Date.parse(text);
      return Number.isNaN(timestamp) ? Date.now() : timestamp;
    }

    function toDateText(value) {
      const date = new Date(toTimestamp(value));
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    }

    function getArticleSignature(article) {
      return encodeURIComponent(JSON.stringify([
        article.id,
        article.title,
        article.summary,
        article.coverImage,
        article.categoryName,
        article.tags,
        Boolean(article.pinned),
        toTimestamp(article.publishedAt),
      ]));
    }

    function getEndpoints(endpoint) {
      if (/^https?:\/\//i.test(endpoint)) return [endpoint];
      const hostname = window.location.hostname;
      if (hostname === "localhost" || hostname === "127.0.0.1") {
        const localBackendEndpoint = "http://localhost:8090/api/user/articles";
        return localBackendEndpoint === endpoint ? [endpoint] : [localBackendEndpoint, endpoint];
      }
      return [endpoint];
    }

    async function fetchArticles() {
      for (const endpoint of getEndpoints(runtimeArticlesUrl)) {
        try {
          const response = await fetch(endpoint, {
            headers: { Accept: "application/json" },
            cache: "no-store",
          });
          if (!response.ok) continue;
          const payload = await response.json();
          if (payload?.code !== 200 || !Array.isArray(payload.data)) continue;
          return payload.data;
        } catch (error) {
          console.warn("文章列表运行时加载失败。", error);
        }
      }
      return null;
    }

    function normalizeArticle(article) {
      const id = normalizeText(String(article?.id ?? ""));
      const title = normalizeText(article?.title);
      if (!id || !title) return null;
      const tags = Array.isArray(article?.tags)
        ? article.tags.map((tag) => normalizeText(tag?.name || tag)).filter(Boolean)
        : [];
      return {
        id,
        title,
        summary: normalizeText(article?.summary),
        coverImage: normalizeText(article?.coverImage),
        categoryName: normalizeText(article?.categoryName),
        tags,
        publishedAt: article?.publishedAt,
        updatedAt: article?.updatedAt,
        pinned: Number(article?.isRecommended) === 1,
      };
    }

    function getCurrentPage() {
      const match = window.location.pathname.match(/^\/(\d+)\/?$/);
      return match ? Math.max(1, Number(match[1]) || 1) : 1;
    }

    function getPostHref(id) {
      return `${runtimePostDetailUrl}?id=${encodeURIComponent(id)}&path=${encodeURIComponent(`/posts/${id}`)}`;
    }

    function refreshRuntimeLayout(container) {
      if (typeof window.updatePostListLayout !== "function") return;
      const savedLayout = localStorage.getItem("postListLayout");
      const defaultLayout = container.getAttribute("data-default-layout") || "list";
      const mobileDefaultLayout = container.getAttribute("data-mobile-default-layout") || defaultLayout;
      const effectiveDefault = window.innerWidth < 780 ? mobileDefaultLayout : defaultLayout;
      const layout = window.innerWidth < 380 ? "grid" : (savedLayout || effectiveDefault);
      window.updatePostListLayout(layout);
      container.querySelectorAll("img").forEach((img) => {
        if (img.complete) return;
        img.addEventListener("load", () => window.updatePostListLayout(layout), { once: true });
      });
    }

    function createTagLinks(tags) {
      return tags
        .slice(0, 4)
        .map((tag) => `<a href="/archive/?tag=${encodeURIComponent(tag)}" class="transition text-xs font-medium px-2.5 py-1 rounded-full bg-black/5 dark:bg-white/10 text-neutral-500 dark:text-neutral-400 hover:bg-(--btn-regular-bg) hover:text-(--btn-content)">#${escapeHtml(tag)}</a>`)
        .join("");
    }

    function iconSvg(name) {
      if (name === "pin") {
        return '<svg width="1em" height="1em" viewBox="0 0 24 24" class="text-xl" aria-hidden="true"><path fill="currentColor" d="M16 12V4h1V2H7v2h1v8l-2 2v2h5v6h2v-6h5v-2z"/></svg>';
      }
      if (name === "calendar") {
        return '<svg width="1em" height="1em" viewBox="0 0 24 24" class="text-xl" aria-hidden="true"><path fill="currentColor" d="M5 22q-.825 0-1.412-.587T3 20V6q0-.825.588-1.412T5 4h1V2h2v2h8V2h2v2h1q.825 0 1.413.588T21 6v14q0 .825-.587 1.413T19 22zm0-2h14V10H5z"/></svg>';
      }
      if (name === "book") {
        return '<svg width="1em" height="1em" viewBox="0 0 24 24" class="text-xl" aria-hidden="true"><path fill="currentColor" d="M6 22q-.825 0-1.412-.587T4 20V5q0-1.25.875-2.125T7 2h13v17q0 .425-.288.713T19 20H7q-.425 0-.712.288T6 21zm1-4h11V4H7q-.425 0-.712.288T6 5v13.25q.225-.125.475-.187T7 18"/></svg>';
      }
      return "";
    }

    function createMeta(article) {
      const category = article.categoryName || "未分类";
      const pinnedHtml = article.pinned
        ? `<div class="pinned-btn flex items-center gap-1 bg-(--btn-regular-bg) text-(--btn-content) rounded-md px-2 py-1.5 font-bold">${iconSvg("pin")}<span class="text-sm">置顶</span></div>`
        : "";
      return `<div class="post-meta-root flex flex-wrap text-neutral-500 dark:text-neutral-400 items-center gap-4 gap-x-4 gap-y-2 mb-4 post-meta card-header-meta">${pinnedHtml}<div class="flex items-center"><div class="meta-icon">${iconSvg("calendar")}</div><span class="text-50 text-sm font-medium">${toDateText(article.publishedAt)}</span></div><div class="flex items-center"><div class="meta-icon">${iconSvg("book")}</div><div class="flex flex-row flex-nowrap items-center"><a href="/archive/?category=${encodeURIComponent(category)}" aria-label="View all posts in the ${escapeHtml(category)} category" class="link-lg transition text-50 text-sm font-medium hover:text-(--primary) dark:hover:text-(--primary) whitespace-nowrap">${escapeHtml(category)}</a></div></div></div>`;
    }

    function createArticleCard(article, index) {
      const href = getPostHref(article.id);
      const hasCover = Boolean(article.coverImage);
      const wrapper = document.createElement("div");
      wrapper.className = `post-card-wrapper ${hasCover ? "has-cover" : "no-cover"} ${article.pinned ? "pinned" : ""} card-base flex flex-col-reverse w-full rounded-(--radius-large) overflow-hidden relative onload-animation post-card-item`;
      wrapper.style.animationDelay = `calc(var(--content-delay) + ${index * 50}ms)`;
      const coverHtml = hasCover
        ? `<a href="${href}" aria-label="${escapeHtml(article.title)}" class="post-card-image group w-full md:w-[30%] aspect-2/1 md:aspect-auto relative md:absolute md:top-4 md:bottom-4 md:right-4 rounded-(--radius-large) md:rounded-xl overflow-hidden"><div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition"></div><img src="${escapeHtml(article.coverImage)}" alt="${escapeHtml(article.title)}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110 group-active:scale-115" loading="lazy" decoding="async"></a>`
        : `<a href="${href}" aria-label="${escapeHtml(article.title)}" class="post-card-enter-btn flex btn-regular w-13 absolute right-3 top-3 bottom-3 rounded-xl bg-(--enter-btn-bg) hover:bg-(--enter-btn-bg-hover) active:bg-(--enter-btn-bg-active) active:scale-95"><span class="transition text-(--primary) text-4xl mx-auto">&rsaquo;</span></a>`;
      wrapper.innerHTML = `<div class="post-card-content pl-4 md:pl-9 pr-4 md:pr-2 pt-4 md:pt-7 pb-4 md:pb-7 relative flex flex-col ${hasCover ? "w-full md:w-[calc(100%-30%-1.5rem)]" : "w-full md:w-[calc(100%-52px-12px)]"}"><a href="${href}" class="post-card-title transition group w-full block font-bold mb-3 text-3xl text-90 hover:text-(--primary) dark:hover:text-(--primary) active:text-(--title-active) dark:active:text-(--title-active) before:w-1 before:h-5 before:rounded-md before:bg-(--primary) before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block">${escapeHtml(article.title)}</a>${createMeta(article)}<div class="transition text-75 md:pr-4 description description-clamped" title="${escapeHtml(article.summary)}">${escapeHtml(article.summary)}</div><div class="post-card-bottom-tags flex flex-wrap items-center gap-1.5 mt-3">${createTagLinks(article.tags)}</div></div>${coverHtml}`;
      return wrapper;
    }

    function renderPagination(totalItems, currentPage) {
      const totalPages = Math.max(1, Math.ceil(totalItems / runtimePageSize));
      document.querySelectorAll(".pagination-wrapper").forEach((node) => {
        node.classList.add("hidden");
      });
      document.querySelector("[data-runtime-post-pagination]")?.remove();
      if (totalPages <= 1) return;
      const pagination = document.createElement("div");
      pagination.dataset.runtimePostPagination = "";
      pagination.className = "pagination-wrapper flex flex-col gap-4 items-center mx-auto onload-animation";
      const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
      pagination.innerHTML = `<div class="flex flex-row gap-3 justify-center" role="navigation">${pages.map((page) => page === currentPage ? `<div class="h-11 w-11 rounded-(--radius-large) bg-(--primary) flex items-center justify-center font-bold text-white dark:text-black/70" aria-current="page">${page}</div>` : `<a href="${page === 1 ? "/" : `/${page}/`}" class="btn-card w-11 h-11 rounded-(--radius-large) overflow-hidden active:scale-[0.85] font-bold text-neutral-700 dark:text-neutral-300">${page}</a>`).join("")}</div>`;
      document.getElementById("post-list-container")?.after(pagination);
    }

    async function loadArticles() {
      const payload = await fetchArticles();
      if (!payload) return;
      const articles = payload
        .map(normalizeArticle)
        .filter(Boolean)
        .sort((a, b) => {
          if (a.pinned && !b.pinned) return -1;
          if (!a.pinned && b.pinned) return 1;
          return toTimestamp(b.publishedAt) - toTimestamp(a.publishedAt);
        });
      const currentPage = getCurrentPage();
      const start = (currentPage - 1) * runtimePageSize;
      const pageArticles = articles.slice(start, start + runtimePageSize);
      const container = document.getElementById("post-list-container");
      if (!container || pageArticles.length === 0) return;
      const runtimeSignature = pageArticles.map(getArticleSignature).join("|");
      if (runtimeSignature && runtimeSignature === container.dataset.renderedPostSignature) {
        refreshRuntimeLayout(container);
        return;
      }
      container.replaceChildren(...pageArticles.map(createArticleCard));
      container.dataset.renderedPostSignature = runtimeSignature;
      renderPagination(articles.length, currentPage);
      refreshRuntimeLayout(container);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", loadArticles, { once: true });
    } else {
      loadArticles();
    }
    document.addEventListener("astro:page-load", loadArticles);
    document.addEventListener("swup:contentReplaced", loadArticles);
  })();
</script>

<!-- 立即执行脚本：防止刷新时的布局闪烁 -->
<script is:inline define:vars={{ defaultLayout, mobileDefaultLayout, columnWidth }}>
  (function() {
    const savedLayout = localStorage.getItem('postListLayout');
    // 根据视口宽度确定有效的默认布局
    const effectiveDefault = window.innerWidth < 780 ? mobileDefaultLayout : defaultLayout;
    // 低于380px强制网格模式
    const effectiveLayout = window.innerWidth < 380 ? 'grid' : (savedLayout || effectiveDefault);

    if (effectiveLayout !== defaultLayout) {
      const container = document.getElementById('post-list-container');

      if (container) {
        // 禁用过渡动画
        container.style.transition = 'none';

        // 移除所有布局类
        container.classList.remove('list-mode', 'grid-mode', 'post-grid-auto', 'flex', 'flex-col', 'gap-4', 'md:gap-4');

        if (effectiveLayout === 'grid') {
          container.classList.add('grid-mode', 'post-grid-auto');
        } else {
          container.classList.add('list-mode', 'flex', 'flex-col', 'gap-4', 'md:gap-4');
        }

        // 强制重排后恢复过渡动画
        container.offsetHeight;
        container.style.transition = '';
      }
    }
  })();
</script>

<script>
  // 动态布局切换脚本
  function initLayout() {
    const postListContainer = document.getElementById("post-list-container");
    if (!postListContainer) return;

    // 从localStorage读取用户偏好
    const savedLayout = localStorage.getItem("postListLayout");
    const defaultLayout =
      postListContainer.getAttribute("data-default-layout") || "list";
    const mobileDefaultLayout =
      postListContainer.getAttribute("data-mobile-default-layout") || defaultLayout;

    // 根据视口宽度确定有效的默认布局
    const effectiveDefault = window.innerWidth < 780 ? mobileDefaultLayout : defaultLayout;
    let currentLayout = savedLayout || effectiveDefault;

    // 低于380px强制网格模式
    if (window.innerWidth < 380) {
      currentLayout = "grid";
    }

    // 应用布局
    updatePostListLayout(currentLayout);
  }

  function updatePostListLayout(layout: string) {
    const postListContainer = document.getElementById("post-list-container");
    if (!postListContainer) return;

    // Check current layout state
    const isCurrentGrid = postListContainer.classList.contains("grid-mode");
    const isCurrentList = postListContainer.classList.contains("list-mode");
    const currentLayout = isCurrentGrid ? "grid" : (isCurrentList ? "list" : null);

    // Common logic vars
    const masonryEnabled = postListContainer.getAttribute("data-masonry-enabled") === "true";

    // Helper to apply layout classes (Pure logic, no animation)
    const applyClasses = () => {
        postListContainer.classList.remove("list-mode", "grid-mode", "post-grid-auto");
        if (layout === "grid") {
            postListContainer.classList.add("grid-mode");
            postListContainer.classList.remove("flex", "flex-col");
            if (masonryEnabled) {
                postListContainer.classList.remove("post-grid-auto");
                applyMasonryLayout();
            } else {
                postListContainer.classList.add("post-grid-auto");
                resetMasonryLayout();
            }
        } else {
            postListContainer.classList.add("list-mode");
            postListContainer.classList.add("flex", "flex-col", "gap-4", "md:gap-4");
            postListContainer.classList.remove("post-grid-auto");
            resetMasonryLayout();
        }
    };

    // Case 1: First run (Initialization) - No animation
    if (!currentLayout) {
        applyClasses();
        return;
    }

    // Case 2: Same layout (e.g. Resize) - No animation, just refresh masonry
    if (currentLayout === layout) {
        if (layout === "grid" && masonryEnabled) {
            applyMasonryLayout();
        }
        return;
    }

    // Case 3: Layout Change - Smooth Animation
    // 1. Fade OUT
    postListContainer.classList.add("layout-switching");

    // 2. Change Layout after fade out (200ms match CSS)
    setTimeout(() => {
        applyClasses();

        // 3. Fade IN (Short delay to ensure DOM update)
        requestAnimationFrame(() => {
            postListContainer.classList.remove("layout-switching");
        });
    }, 200);
  }

  (window as Window & typeof globalThis & { updatePostListLayout?: (layout: string) => void }).updatePostListLayout = updatePostListLayout;

  function resetMasonryLayout() {
    const container = document.getElementById("post-list-container");
    if (!container) return;

    container.style.height = "";
    container.style.position = "";
    container.style.display = "";

    const items = container.querySelectorAll(".post-card-item");
    items.forEach((item) => {
      // @ts-ignore
      item.style.position = "";
      // @ts-ignore
      item.style.top = "";
      // @ts-ignore
      item.style.left = "";
      // @ts-ignore
      item.style.width = "";
    });
  }

  function applyMasonryLayout() {
    const container = document.getElementById("post-list-container");
    if (!container) return;

    const masonryEnabled = container.getAttribute("data-masonry-enabled") === "true";
    if (!masonryEnabled) return;

    // 仅在 grid 模式下应用
    if (!container.classList.contains("grid-mode")) return;

    const items = Array.from(container.querySelectorAll(".post-card-item"));
    if (items.length === 0) return;

    // 瀑布流配置
    const gap = 16; // 1rem = 16px
    const columnWidth = parseInt(container.getAttribute("data-column-width") || "280");

    // 重置容器样式以允许绝对定位
    container.style.position = "relative";
    container.style.display = "block"; // 覆盖 grid display

    // 使用 offsetWidth 避免 transform: scale 的影响
    const containerWidth = container.offsetWidth;
    // 根据容器宽度和最小列宽动态计算列数
    const colCount = Math.max(1, Math.floor((containerWidth + gap) / (columnWidth + gap)));
    const itemWidth = (containerWidth - (colCount - 1) * gap) / colCount;

    const colHeights = new Array(colCount).fill(0);

    items.forEach((item) => {
      // 找到最短的列放置
      const colIndex = colHeights.indexOf(Math.min(...colHeights));

      // @ts-ignore
      item.style.position = "absolute";
      // @ts-ignore
      item.style.width = `${itemWidth}px`;
      // @ts-ignore
      item.style.setProperty('height', 'auto', 'important');

      // 获取高度，优先使用 offsetHeight 避免 transform 影响
      // @ts-ignore
      const height = item.offsetHeight;

      const top = colHeights[colIndex];
      const left = colIndex * (itemWidth + gap);

      // @ts-ignore
      item.style.top = `${top}px`;
      // @ts-ignore
      item.style.left = `${left}px`;

      colHeights[colIndex] += height + gap;
    });

    container.style.height = `${Math.max(...colHeights)}px`;
  }

  // 页面加载时初始化布局
  document.addEventListener("DOMContentLoaded", function () {
    // 延迟一点确保DOM完全加载
    setTimeout(initLayout, 50);

    // 监听图片加载以重新计算布局
    const imgs = document.querySelectorAll('#post-list-container img');
    imgs.forEach(img => {
        // @ts-ignore
        if(img.complete) return;
        img.addEventListener('load', () => {
            applyMasonryLayout();
        });
    });
  });

  // 页面显示时也初始化布局（处理页面切换）
  document.addEventListener("visibilitychange", function () {
    if (!document.hidden) {
      setTimeout(initLayout, 100);
    }
  });

  // 监听布局变化事件
  window.addEventListener("layoutChange", function (event) {
    // @ts-ignore
    const newLayout = event.detail.layout;
    const postListContainer = document.getElementById("post-list-container");
    if (!postListContainer) return;

    updatePostListLayout(newLayout);
  });

  // 监听窗口大小变化
  let resizeTimeout: any;
  window.addEventListener("resize", function () {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function () {
      initLayout();
    }, 250);
  });

  // 监听页面导航事件（Astro的客户端路由）
  document.addEventListener("astro:page-load", function () {
    setTimeout(initLayout, 50);

    // 监听图片加载
    const imgs = document.querySelectorAll('#post-list-container img');
    imgs.forEach(img => {
        // @ts-ignore
        if(img.complete) return;
        img.addEventListener('load', () => {
            applyMasonryLayout();
        });
    });
  });

  document.addEventListener("astro:after-swap", function () {
    setTimeout(initLayout, 50);
  });

  // 立即执行一次（处理页面刷新）
  setTimeout(initLayout, 0);
</script>

<style is:global>
  .post-grid-auto {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--post-card-min-width, 320px), 1fr));
    gap: 1rem;
  }

  /* 移动端列表模式下缩小元数据 */
  @media (max-width: 767px) {
    .list-mode .post-meta-root {
      transform: scale(0.72) !important;
      transform-origin: top left !important;
      margin-bottom: 0.25rem !important;
      width: 139% !important;
    }
    .list-mode .post-meta.card-header-meta {
      transform: scale(0.9) !important;
      width: 111% !important;
      margin-bottom: 0.5rem !important;
      gap: 0.5rem !important;
    }
    .list-mode :global(.post-meta) {
      margin-bottom: 0.25rem !important;
      gap: 0.25rem !important;
    }
  }
</style>

<style>
  /* 布局切换动画 */
  #post-list-container {
    /* 限制过渡属性为 opacity 和 transform，避免响应父元素位置变化 */
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
